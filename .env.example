# Public site URL used for metadata, sharing, and calendar links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin access. Required in production.
ADMIN_EMAIL=admin@themingle.local
ADMIN_PASSWORD=change-me
ADMIN_SESSION_SECRET=replace-with-a-long-random-string

# Server only. The service role must never be exposed in the browser.
# This project stores The Mingle in one table, mingle_app, so a shared free database stays small.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Payment secrets stay on the server. Leave blank until you are ready.
# The active provider is chosen in the admin settings, not hard-coded.
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_HASH=

# Optional later: email delivery.
RESEND_API_KEY=
EMAIL_FROM=
